-- {{ company_name }} — synthetic training database ({{ mssql_business_db }})
-- CPTC12 theme: an aging family-owned THEME PARK (rides, attractions, patrons).
-- Stage 1: BENIGN operations data only. NO planted credentials/secrets here.
-- (Stage 3 adds ApplicationConfig secrets, backups on shares, linked servers.)
-- All data is fictional. Do NOT insert real people or records.
SET NOCOUNT ON;

IF DB_ID('{{ mssql_business_db }}') IS NULL
    CREATE DATABASE [{{ mssql_business_db }}];
GO
USE [{{ mssql_business_db }}];
GO

IF OBJECT_ID('dbo.Departments') IS NULL
CREATE TABLE dbo.Departments (
    DeptID   INT PRIMARY KEY,
    Name     NVARCHAR(64) NOT NULL,
    Location NVARCHAR(64) NULL
);
IF OBJECT_ID('dbo.Employees') IS NULL
CREATE TABLE dbo.Employees (
    EmpID    INT PRIMARY KEY,
    FullName NVARCHAR(96) NOT NULL,
    Title    NVARCHAR(64) NULL,
    DeptID   INT NULL,
    Email    NVARCHAR(128) NULL,
    HireDate DATE NULL
);
-- Rides / attractions = the park's core "asset inventory"
IF OBJECT_ID('dbo.Attractions') IS NULL
CREATE TABLE dbo.Attractions (
    AttractionID INT PRIMARY KEY,
    Name         NVARCHAR(96) NOT NULL,
    Type         NVARCHAR(48) NULL,   -- Coaster / Water / Family / Show
    Zone         NVARCHAR(48) NULL,
    YearInstalled INT NULL,           -- "aging" park: some old, some new
    Status       NVARCHAR(24) NULL    -- Operational / Maintenance / Closed
);
IF OBJECT_ID('dbo.Patrons') IS NULL
CREATE TABLE dbo.Patrons (
    PatronID INT PRIMARY KEY,
    Name     NVARCHAR(96) NOT NULL,
    Email    NVARCHAR(128) NULL,
    City     NVARCHAR(64) NULL
);
IF OBJECT_ID('dbo.SeasonPasses') IS NULL
CREATE TABLE dbo.SeasonPasses (
    PassID   INT PRIMARY KEY,
    PatronID INT NULL,
    Tier     NVARCHAR(24) NULL,       -- Bronze / Silver / Gold
    ValidThru DATE NULL
);
IF OBJECT_ID('dbo.Vendors') IS NULL
CREATE TABLE dbo.Vendors (
    VendorID INT PRIMARY KEY,
    Name     NVARCHAR(96) NOT NULL,
    Category NVARCHAR(48) NULL        -- RideParts / Food / Merch / Facilities
);
IF OBJECT_ID('dbo.Invoices') IS NULL
CREATE TABLE dbo.Invoices (
    InvoiceID INT PRIMARY KEY,
    VendorID  INT NULL,
    AmountUSD DECIMAL(12,2) NULL,
    IssuedOn  DATE NULL,
    Status    NVARCHAR(24) NULL
);
IF OBJECT_ID('dbo.MaintenanceTickets') IS NULL
CREATE TABLE dbo.MaintenanceTickets (
    TicketID     INT PRIMARY KEY,
    AttractionID INT NULL,
    Subject      NVARCHAR(128) NULL,
    Priority     NVARCHAR(16) NULL,
    Status       NVARCHAR(24) NULL
);
IF OBJECT_ID('dbo.Projects') IS NULL
CREATE TABLE dbo.Projects (
    ProjID INT PRIMARY KEY,
    Name   NVARCHAR(96) NOT NULL,
    Owner  NVARCHAR(96) NULL,
    Status NVARCHAR(24) NULL
);
GO

